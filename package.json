{
  "name": "gorak-vscode-ext",
  "displayName": "gorak OpenROAD",
  "description": "OpenROAD language services for gorak source projects.",
  "version": "0.9.13",
  "publisher": "dougwhite",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/gorak.json",
    "onLanguage:gorak-openroad",
    "onLanguage:gorak-wml",
    "onCustomEditor:gorak.frameDesigner"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Workspace indexing reads local source and included components. Trust the folder to enable language services."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "languages": [
      {
        "id": "gorak-openroad",
        "aliases": [
          "gorak OpenROAD"
        ],
        "extensions": [
          ".w4gl"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/light/w4gl.svg",
          "dark": "./icons/dark/w4gl.svg"
        }
      },
      {
        "id": "gorak-wml",
        "aliases": [
          "gorak WML"
        ],
        "extensions": [
          ".wml"
        ],
        "configuration": "./wml-language-configuration.json",
        "icon": {
          "light": "./icons/light/wml.svg",
          "dark": "./icons/dark/wml.svg"
        }
      },
      {
        "id": "gorak-project",
        "aliases": [
          "gorak Project (JSON)"
        ],
        "filenames": [
          "gorak.json"
        ],
        "configuration": "./project-language-configuration.json",
        "icon": {
          "light": "./icons/light/project.svg",
          "dark": "./icons/dark/project.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "gorak-openroad",
        "scopeName": "source.gorak",
        "path": "./syntaxes/gorak.tmLanguage.json"
      },
      {
        "scopeName": "source.gorak.4gl",
        "path": "./syntaxes/openroad.tmLanguage.json"
      },
      {
        "language": "gorak-wml",
        "scopeName": "text.xml.gorak",
        "path": "./syntaxes/wml.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.openroad": "gorak-openroad"
        }
      },
      {
        "language": "gorak-project",
        "scopeName": "source.json.gorak-project",
        "path": "./syntaxes/project.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "gorak.restartServer",
        "title": "gorak: Restart Language Server"
      },
      {
        "command": "gorak.showIndexStatus",
        "title": "gorak: Show Index Status"
      },
      {
        "command": "gorak.explainSymbol",
        "title": "gorak: Explain Symbol Resolution"
      },
      {
        "command": "gorak.rebuildIndex",
        "title": "gorak: Rebuild Index"
      },
      {
        "command": "gorak.findClassReferences",
        "title": "gorak: Find Class References"
      },
      {
        "command": "gorak.showDiagnostics",
        "title": "gorak: Show Language Server Diagnostics"
      },
      {
        "command": "gorak.findReferences",
        "title": "gorak: Find All References (Full Lines)"
      },
      {
        "command": "gorak.copyDiagnostics",
        "title": "gorak: Copy Diagnostic Summary"
      },
      {
        "command": "gorak.openFrameSource",
        "title": "gorak: Open Raw WML",
        "icon": "$(code)"
      },
      {
        "command": "gorak.openFrameDesigner",
        "title": "gorak: Open Frame Designer",
        "icon": "$(preview)"
      }
    ],
    "configuration": {
      "title": "gorak",
      "properties": {
        "gorak.autoDetect": {
          "type": "boolean",
          "default": true,
          "description": "Select gorak language modes for W4GL/WML files beneath gorak.json. Turn off to choose modes manually."
        },
        "gorak.detailCacheMB": {
          "type": "number",
          "default": 32,
          "minimum": 8,
          "maximum": 512,
          "description": "Approximate memory budget in MB for cached source text and tokens. Symbol summaries and temporary parsing allocations are additional. Restart the language server to apply."
        },
        "gorak.frameDesigner.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Open WML files in the frame designer. Disable to use the raw text editor."
        },
        "gorak.projectFileIcon.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Use the gorak ork language fallback icon for `gorak.json` by selecting the custom `gorak-project` language mode. Disable to restore normal JSON extension and `[json]` settings compatibility. Explicit `files.associations` overrides take precedence; your selected icon theme is unchanged."
        }
      }
    },
    "keybindings": [
      {
        "command": "gorak.findReferences",
        "key": "shift+alt+f12",
        "when": "editorTextFocus && (editorLangId == gorak-openroad || editorLangId == gorak-wml)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "gorak.findReferences",
          "when": "editorLangId == gorak-openroad || editorLangId == gorak-wml",
          "group": "0_navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "gorak.openFrameSource",
          "when": "activeCustomEditorId == gorak.frameDesigner",
          "group": "navigation"
        },
        {
          "command": "gorak.openFrameDesigner",
          "when": "resourceExtname == .wml && activeCustomEditorId != gorak.frameDesigner && config.gorak.frameDesigner.enabled",
          "group": "navigation"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "**/field_defaults.json",
          "**/*.fielddefaults.json"
        ],
        "url": "./schemas/native-styles.schema.json"
      },
      {
        "fileMatch": [
          "**/gorak.json"
        ],
        "url": "./schemas/project.schema.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "gorak.frameDesigner",
        "displayName": "gorak Frame Designer",
        "selector": [
          {
            "filenamePattern": "*.wml"
          }
        ],
        "priority": "default"
      }
    ],
    "jsonLanguageParticipants": [
      {
        "languageId": "gorak-project",
        "comments": false
      }
    ],
    "configurationDefaults": {
      "[gorak-project]": {
        "editor.quickSuggestions": {
          "strings": true
        },
        "editor.suggest.insertMode": "replace"
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "format": "prettier --write src test scripts esbuild.mjs package.json tsconfig.json syntaxes schemas *.json .github .vscode",
    "format:check": "prettier --check src test scripts esbuild.mjs package.json tsconfig.json syntaxes schemas *.json .github .vscode",
    "vscode:prepublish": "npm run check && npm run build",
    "package": "node scripts/package.mjs",
    "verify": "npm run check && npm test && npm run build",
    "test:editor": "npm run build && node scripts/test-host.mjs",
    "pretest": "npm run build",
    "test:restart": "npm run build && node scripts/test-restart.mjs",
    "fetch:server": "node scripts/fetch-server.mjs",
    "test:installed": "node scripts/test-installed.mjs",
    "test:designer": "npm run build && node scripts/test-designer.mjs",
    "fetch:compatibility": "node scripts/fetch-compatibility.mjs",
    "test:compatibility": "node scripts/test-installed.mjs --compatibility",
    "test:icons": "npm run build && node scripts/test-icons.mjs"
  },
  "dependencies": {
    "gorak-frame-designer": "https://github.com/dougwhite/gorak-frame-designer/releases/download/v0.1.0-alpha.4/gorak-frame-designer-0.1.0-alpha.4.tgz",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.93.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vscode-json-languageservice": "^6.0.0-next.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dougwhite/gorak-vscode-ext.git"
  },
  "bugs": {
    "url": "https://github.com/dougwhite/gorak-vscode-ext/issues"
  },
  "extensionDependencies": [
    "vscode.json-language-features"
  ],
  "icon": "icons/gorak.png"
}
